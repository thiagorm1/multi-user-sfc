# Copie para .env para ativar MAPPO com planejamento Qwen via Ollama.
MUAR_ALG=mappo
MUAR_COGNITIVE_PLANNER=true
MUAR_COGNITIVE_LLM_MODEL=qwen2.5:1.5b
MUAR_COGNITIVE_API_BASE_URL=http://localhost:11434/v1
MUAR_COGNITIVE_API_TIMEOUT=30
MUAR_COGNITIVE_MAX_TOKENS=1024
MUAR_COGNITIVE_PLANNER_INTERVAL=30
MUAR_MOBILITY=false
