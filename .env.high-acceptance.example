# Perfil dimensionado para as cargas avaliadas; não garante 100% em qualquer carga.
MUAR_ALG=mappo
MUAR_TOPOLOGY=luxembourgv2
MUAR_DAG=true
MUAR_SHARE=true
MUAR_SHAREBAND=true
MUAR_ALLOW_DELAY=true
MUAR_ADMISSION_MAX_WAIT=30
MUAR_ADMISSION_RETRY_INTERVAL=1
MUAR_CPU_CAPACITY_FACTOR=3.6
MUAR_CACHE_CAPACITY_FACTOR=3.6
MUAR_LINK_CAPACITY_FACTOR=8
MUAR_WIRELESS_CAPACITY_FACTOR=4
MUAR_SOURCE_BANDWIDTH_MBPS=40000
MUAR_MAPPO_SEARCH_ATTEMPTS=8
MUAR_MAPPO_POLICY_WEIGHT=0.5
MUAR_MAPPO_MODEL_PATH=rl_saved_models/MAPPO_acceptance_model.pt
MUAR_SEED=42
MUAR_N_SESSIONS=30
MUAR_N_PLAYERS=4
MUAR_OFFICIAL_RATE=3
MUAR_MOBILITY=false
MUAR_BACKUP=false
MUAR_NUMBER_OF_FAILS=0
MUAR_COGNITIVE_PLANNER=true
MUAR_COGNITIVE_LLM_MODEL=mock
MUAR_COGNITIVE_PLANNER_INTERVAL=30
# Para adicionar Qwen: MUAR_COGNITIVE_LLM_MODEL=qwen2.5:1.5b
# MUAR_COGNITIVE_API_BASE_URL=http://localhost:11434/v1

# SLA de rede e processamento; prazo de admissão é medido separadamente.
MUAR_LATENCY=50
