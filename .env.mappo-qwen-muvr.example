# MUVR: original nominal capacities; immediate admission, SLA 6 ms.
# Uses virtual time. One request is a complete four-player regional session.
MUAR_APPLICATION=muvr_reference
MUAR_ALG=mappo
MUAR_TOPOLOGY=erdos_renyi
MUAR_NUMBER_OF_NODES=25
MUAR_N_SESSIONS=50
MUAR_N_PLAYERS=4
MUAR_OFFICIAL_RATE=10
MUAR_SFC_LIFETIME=120
MUAR_LATENCY=6
MUAR_MUVR_DESTINATION_MODE=same_access
MUAR_CPU_CAPACITY_FACTOR=1
MUAR_CACHE_CAPACITY_FACTOR=1
MUAR_LINK_CAPACITY_FACTOR=1
MUAR_WIRELESS_CAPACITY_FACTOR=1
MUAR_SOURCE_BANDWIDTH_MBPS=0
MUAR_ALLOW_DELAY=false
MUAR_ADMISSION_MAX_WAIT=0
MUAR_SHARE=true
MUAR_SHAREBAND=true
MUAR_MOBILITY=false
MUAR_BACKUP=false
MUAR_NUMBER_OF_FAILS=0
MUAR_NUMBER_OF_LINK_FAILS=0
MUAR_COGNITIVE_PLANNER=true
MUAR_SEED=42

# Trained four-region MAPPO actors + pretrained local Qwen, running on CPU.
MUAR_N_MAPPO_REGIONS=4
MUAR_MAPPO_MODEL_PATH=rl_saved_models/MAPPO_muvr_model.pt
MUAR_COGNITIVE_LLM_MODEL=qwen2.5:1.5b
MUAR_COGNITIVE_API_BASE_URL=http://localhost:11434/v1
MUAR_COGNITIVE_API_TIMEOUT=120
MUAR_COGNITIVE_MAX_TOKENS=256
MUAR_COGNITIVE_PLANNER_INTERVAL=60

# Wall-clock validity of cached background Qwen guidance.
MUAR_COGNITIVE_GUIDANCE_MAX_AGE=120
